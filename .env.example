# Copy this file to .env and fill in what you need. .env is git-ignored; never commit real keys.

# Which model backend to use: anthropic | openai | gemini | ollama
FILEFERRET_PROVIDER=anthropic
# Leave empty to use the provider's default model
FILEFERRET_MODEL=

# Claude (provider=anthropic)
ANTHROPIC_API_KEY=

# ChatGPT (provider=openai)
OPENAI_API_KEY=
# Optional: point at an OpenAI-compatible server (LM Studio, vLLM, ...)
# OPENAI_BASE_URL=http://localhost:1234/v1

# Google Gemini (provider=gemini) - key from https://aistudio.google.com
GEMINI_API_KEY=

# Local models (provider=ollama)
OLLAMA_HOST=http://localhost:11434
